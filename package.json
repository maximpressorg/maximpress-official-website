{
  "name": "maximpress-owner-firebase-maintenance",
  "private": true,
  "version": "9.0.0",
  "description": "Static MaxImpress Premium website; no public authentication or admin portal",
  "type": "module",
  "scripts": {
    "check:js": "node --check public/assets/site.js && node --check public/assets/inquiry.js",
    "check:links": "npx --yes linkinator@7.5.3 public --recurse --verbosity error --skip \"https://.*\"",
    "test": "npm run check:js && npm run check:links"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
